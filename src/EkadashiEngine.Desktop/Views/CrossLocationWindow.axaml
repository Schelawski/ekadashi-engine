<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EkadashiEngine.Desktop.ViewModels"
        xmlns:views="using:EkadashiEngine.Desktop.Views"
        x:Class="EkadashiEngine.Desktop.Views.CrossLocationWindow"
        x:DataType="vm:CrossLocationViewModel"
        Title="Ekadashi Engine · Ortsvergleich" Width="1280" Height="960" MinWidth="1080" MinHeight="820"
        Background="#F4F6F8">
  <Grid RowDefinitions="Auto,Auto,2*,Auto,3*,Auto" Margin="24" RowSpacing="12">
    <StackPanel Spacing="5">
      <TextBlock Text="Orte im selben Jahr vergleichen" FontSize="26" FontWeight="SemiBold" Foreground="#183B3A" />
      <TextBlock Text="Verglichen werden gleiche lokale Kalenderdaten; Sonnenaufgänge können dabei auf unterschiedliche UTC-Daten fallen."
                 Foreground="#556579" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" Background="White" Padding="16" CornerRadius="8">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="140,*,Auto,Auto" ColumnSpacing="12">
          <NumericUpDown x:Name="ComparisonYearInput" Value="{Binding Year, Mode=TwoWay}" FormatString="0.##"
                         Minimum="1900" Maximum="2100" IsEnabled="{Binding !IsBusy}" />
          <ComboBox x:Name="ComparisonTraditionSelector" Grid.Column="1" ItemsSource="{Binding Traditions}"
                    SelectedItem="{Binding SelectedTradition, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:TraditionOption"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button x:Name="CompareButton" Grid.Column="2" Content="Vergleichen" Command="{Binding CalculateCommand}" />
          <Button Grid.Column="3" Content="Abbrechen" Command="{Binding CalculateCancelCommand}" IsVisible="{Binding IsBusy}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <ItemsControl x:Name="ComparisonLocationChoices" ItemsSource="{Binding Locations}" IsEnabled="{Binding !IsBusy}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LocationChoice">
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,16,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Grid.Column="1" Content="Alle Orte" Command="{Binding SelectAllCommand}" VerticalAlignment="Top" />
        </Grid>
        <Expander Header="Eigenen Ort hinzufügen" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}">
          <StackPanel Spacing="8">
            <views:LocationEditorView x:Name="ComparisonLocationEditor" DataContext="{Binding LocationEditor}" />
            <Button x:Name="AddComparisonLocationButton" Content="Zum Vergleich hinzufügen" Command="{Binding AddLocationCommand}" />
          </StackPanel>
        </Expander>
        <TextBlock Text="{Binding ValidationMessage}" Foreground="#A52B26" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
      <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <DataGrid x:Name="LocationSummaryTable" Grid.Row="1" ItemsSource="{Binding Summaries}" IsReadOnly="True" AutoGenerateColumns="False" Background="White">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Ort" Binding="{ReflectionBinding Name}" Width="*" />
          <DataGridTextColumn Header="Breite, Länge" Binding="{ReflectionBinding Coordinates}" Width="*" />
          <DataGridTextColumn Header="IANA-Zeitzone" Binding="{ReflectionBinding TimeZone}" Width="2*" />
          <DataGridTextColumn Header="Ja-Tage (je Modus)" Binding="{ReflectionBinding SelectedDays}" Width="*" />
          <DataGridTextColumn Header="Ungeklärte Tage" Binding="{ReflectionBinding UnknownDays}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <TextBlock Text="Lokales Datum" VerticalAlignment="Center" />
      <ComboBox x:Name="ComparisonDaySelector" Grid.Column="1" ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay, Mode=TwoWay}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:LocationComparisonDay"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <CheckBox x:Name="LocationDifferencesFilter" Grid.Column="2" Content="Nur unterschiedliche / ungeklärte Tage"
                IsChecked="{Binding ShowDifferencesOnly, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
    </Grid>
    <DataGrid x:Name="LocationDayTable" Grid.Row="4" ItemsSource="{Binding DayRows}" IsReadOnly="True" AutoGenerateColumns="False" Background="White">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Ort" Binding="{ReflectionBinding Name}" Width="140" />
        <DataGridTextColumn Header="Breite, Länge" Binding="{ReflectionBinding Coordinates}" Width="190" />
        <DataGridTextColumn Header="Zeitzone" Binding="{ReflectionBinding TimeZone}" Width="200" />
        <DataGridTextColumn Header="Sonnenaufgang lokal" Binding="{ReflectionBinding SunriseLocal}" Width="235" />
        <DataGridTextColumn Header="Sonnenaufgang UTC" Binding="{ReflectionBinding SunriseUtc}" Width="220" />
        <DataGridTextColumn Header="Tithi" Binding="{ReflectionBinding Tithi}" Width="80" />
        <DataGridTextColumn Header="Auswahl" Binding="{ReflectionBinding Selection}" Width="100" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="5" Spacing="5">
      <TextBlock Text="{Binding ModeDescription}" Foreground="#556579" FontSize="12" TextWrapping="Wrap" />
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="4" />
      <TextBlock x:Name="CrossLocationStatusText" Text="{Binding StatusMessage}" Foreground="#556579" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
