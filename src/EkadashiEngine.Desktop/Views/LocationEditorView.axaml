<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EkadashiEngine.Desktop.ViewModels"
             x:Class="EkadashiEngine.Desktop.Views.LocationEditorView"
             x:DataType="vm:LocationEditorViewModel">
  <StackPanel Spacing="8">
    <Grid ColumnDefinitions="2*,100,*,*,2*" ColumnSpacing="12">
      <StackPanel Spacing="4">
        <TextBlock Text="Ortsname" />
        <TextBox x:Name="CustomLocationName" Text="{Binding DisplayName, Mode=TwoWay}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="Land (Label)" />
        <TextBox x:Name="CustomCountry" Text="{Binding Country, Mode=TwoWay}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Text="Breite / Latitude" />
        <NumericUpDown x:Name="CustomLatitude" Value="{Binding Latitude, Mode=TwoWay}" Minimum="-90" Maximum="90" Increment="0.01" FormatString="0.######" />
      </StackPanel>
      <StackPanel Grid.Column="3" Spacing="4">
        <TextBlock Text="Länge / Longitude" />
        <NumericUpDown x:Name="CustomLongitude" Value="{Binding Longitude, Mode=TwoWay}" Minimum="-180" Maximum="180" Increment="0.01" FormatString="0.######" />
      </StackPanel>
      <StackPanel Grid.Column="4" Spacing="4">
        <TextBlock Text="IANA-Zeitzone" />
        <AutoCompleteBox x:Name="CustomTimeZone" ItemsSource="{Binding TimeZoneIds}" Text="{Binding TimeZoneId, Mode=TwoWay}"
                         FilterMode="Contains" MinimumPrefixLength="0" />
      </StackPanel>
    </Grid>
    <TextBlock Text="{Binding ValidationMessage}" Foreground="#A52B26" TextWrapping="Wrap" />
    <TextBlock Text="Breite: Nord positiv · Länge: Ost positiv. Die Zeitzone muss zu den Koordinaten passen; sie wird hier manuell gesetzt."
               Foreground="#556579" FontSize="12" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
