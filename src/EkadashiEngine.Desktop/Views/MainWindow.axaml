<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EkadashiEngine.Desktop.ViewModels"
        xmlns:core="using:EkadashiEngine.Core"
        xmlns:views="using:EkadashiEngine.Desktop.Views"
        x:Class="EkadashiEngine.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Ekadashi Engine · Marga Smriti"
        Width="1120" Height="880" MinWidth="960" MinHeight="740"
        Background="#F4F6F8">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="16" RowSpacing="10">
    <StackPanel Spacing="6">
      <TextBlock Text="MARGA SMRITI / REFERENZPROJEKT" FontSize="12" Foreground="#556579" />
      <TextBlock Text="Ekadashi Engine" FontSize="30" FontWeight="SemiBold" Foreground="#183B3A" />
      <TextBlock Text="Jahresübersicht und Vergleich mit Referenzkalendern"
                 Foreground="#556579" />
    </StackPanel>

    <Border Grid.Row="1" Background="White" Padding="12" CornerRadius="8">
      <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="2*,140,3*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="6" IsEnabled="{Binding !IsBusy}">
            <TextBlock Text="Ort / Vorlage" FontWeight="SemiBold" />
            <ComboBox x:Name="LocationSelector" ItemsSource="{Binding Locations}"
                      SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Ort">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:Location">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6" IsEnabled="{Binding !IsBusy}">
            <TextBlock Text="Jahr (1900–2100)" FontWeight="SemiBold" />
            <NumericUpDown x:Name="YearInput" Value="{Binding Year, Mode=TwoWay}"
                           Minimum="{Binding MinimumYear}" Maximum="{Binding MaximumYear}" Increment="1" FormatString="0.##"
                           AllowSpin="True" AutomationProperties.Name="Jahr" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="6" IsEnabled="{Binding !IsBusy}">
            <TextBlock Text="Tradition / Modus" FontWeight="SemiBold" />
            <ComboBox x:Name="TraditionSelector" ItemsSource="{Binding Traditions}"
                      SelectedItem="{Binding SelectedTradition, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Tradition">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TraditionOption">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <Button x:Name="CalculateButton" Content="Berechnen" Command="{Binding CalculateCommand}" Padding="20,8" />
            <Button x:Name="CancelButton" Content="Abbrechen" Command="{Binding CalculateCancelCommand}" IsVisible="{Binding IsBusy}" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="Zeitzone:" Foreground="#556579" />
            <TextBlock x:Name="TimeZoneText" Text="{Binding EffectiveLocation.TimeZoneId}" />
            <TextBlock Text="{Binding EffectiveCoordinates}" Foreground="#556579" />
          </StackPanel>
          <Button x:Name="CompareLocationsButton" Grid.Column="1" Content="Orte vergleichen …" Click="CompareLocationsClicked"
                  IsEnabled="{Binding CanCompareLocations}" />
        </Grid>
        <Expander x:Name="CustomLocationExpander" Header="Eigene Koordinaten verwenden" IsExpanded="{Binding UseCustomLocation, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}">
          <views:LocationEditorView x:Name="CustomLocationEditor" DataContext="{Binding LocationEditor}" Margin="0,8,0,0" />
        </Expander>
        <Border Background="#EDF4F3" CornerRadius="4" Padding="12">
          <TextBlock Text="{Binding ModeDescription}"
                     TextWrapping="Wrap" Foreground="#284D49" />
        </Border>
        <TextBlock x:Name="YearValidationText" Text="{Binding YearValidationMessage}" Foreground="#A52B26"
                   IsVisible="{Binding HasYearValidationError}" />
      </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="12" IsVisible="{Binding !IsTraditionalMode}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock x:Name="ResultSummaryText" Text="{Binding ResultSummary}" FontSize="16" FontWeight="SemiBold"
                   VerticalAlignment="Center" TextWrapping="Wrap" />
        <CheckBox x:Name="CandidateFilter" Grid.Column="1" Content="Nur Kandidaten"
                  IsChecked="{Binding ShowCandidatesOnly, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
      </Grid>
      <Grid Grid.Row="1">
        <DataGrid x:Name="ResultsTable" ItemsSource="{Binding Results}" IsReadOnly="True"
                  SelectedItem="{Binding SelectedResult, Mode=TwoWay}" SelectionMode="Single"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal" Background="White"
                  BorderBrush="#DDE3E8" BorderThickness="1">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Lokales Datum" Binding="{ReflectionBinding LocalDate}" Width="*" />
            <DataGridTextColumn Header="Sonnenaufgang (lokal)" Binding="{ReflectionBinding Sunrise}" Width="*" />
            <DataGridTextColumn Header="Tithi bei Sonnenaufgang" Binding="{ReflectionBinding TithiAtSunrise}" Width="*" />
            <DataGridTextColumn Header="Ekadashi-Kandidat" Binding="{ReflectionBinding Candidate}" Width="*" />
            <DataGridTemplateColumn Header="Details" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ResultRow">
                  <Button Content="Details" Command="{Binding ShowDetailsCommand}" Margin="4,2" Padding="10,4" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel IsVisible="{Binding !Results.Count}" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Spacing="6" IsHitTestVisible="False">
          <TextBlock Text="Keine angezeigten Tage" FontSize="17" HorizontalAlignment="Center" />
          <TextBlock Text="Berechnung starten oder Kandidatenfilter prüfen."
                     Foreground="#556579" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>

    <Grid x:Name="ComparisonPanel" Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="12"
          IsVisible="{Binding ShowComparisonOverview}">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock x:Name="FastingSummaryText" Text="{Binding ResultSummary}" FontSize="16" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextWrapping="Wrap" />
          <CheckBox x:Name="MismatchFilter" Grid.Column="1" Content="Nur Referenzabweichungen"
                    IsChecked="{Binding ShowMismatchesOnly, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
        </Grid>
        <Border Background="White" CornerRadius="6" Padding="12">
          <StackPanel Spacing="6">
            <TextBlock x:Name="ComparisonSummaryText" Text="{Binding ComparisonSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ReferenceDescriptionText" Text="{Binding ReferenceDescription}" Foreground="#556579" FontSize="12" TextWrapping="Wrap" />
            <SelectableTextBlock x:Name="ReferenceSourceText" Text="{Binding ReferenceSource}" Foreground="#284D49" FontSize="12" TextWrapping="Wrap" />
            <TextBlock x:Name="ComparisonWarningText" Text="{Binding ComparisonWarning}" Foreground="#A52B26" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
      <Grid Grid.Row="1">
        <DataGrid x:Name="ComparisonTable" ItemsSource="{Binding ComparisonRows}" IsReadOnly="True"
                  SelectedItem="{Binding SelectedComparisonRow, Mode=TwoWay}" SelectionMode="Single"
                  AutoGenerateColumns="False" GridLinesVisibility="Horizontal" Background="White"
                  BorderBrush="#DDE3E8" BorderThickness="1">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Ananda Marga" Binding="{ReflectionBinding AnandaMargaDate}" Width="*" MinWidth="125" />
            <DataGridTextColumn Header="Vaishnava" Binding="{ReflectionBinding VaishnavaDate}" Width="*" MinWidth="125" />
            <DataGridTextColumn Header="Δ Traditionen" Binding="{ReflectionBinding TraditionDifference}" Width="135" />
            <DataGridTextColumn Header="Referenz (gewählt)" Binding="{ReflectionBinding Official}" Width="*" MinWidth="155" />
            <DataGridTemplateColumn Header="Status" Width="165">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ComparisonRow">
                  <Border Background="{Binding StatusBackground}" CornerRadius="4" Margin="6,4" Padding="8,5">
                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontWeight="SemiBold" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Δ zur Referenz" Binding="{ReflectionBinding Difference}" Width="*" MinWidth="160" />
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel IsVisible="{Binding !ComparisonRows.Count}" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Spacing="6" IsHitTestVisible="False">
          <TextBlock Text="Keine angezeigten Vergleichszeilen" FontSize="17" HorizontalAlignment="Center" />
          <TextBlock Text="Berechnung starten oder Abweichungsfilter prüfen." Foreground="#556579" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>

    <Border x:Name="ComparisonDetailsPanel" Grid.Row="2" IsVisible="{Binding HasSelectedComparisonRow}"
            Background="White" CornerRadius="8" Padding="16">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Regelentscheidung" FontSize="18" FontWeight="SemiBold" />
          <Button Grid.Column="1" Content="Schließen" Command="{Binding CloseComparisonDetailsCommand}" Padding="10,3" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding SelectedComparisonRow.DetailTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
          <SelectableTextBlock x:Name="ComparisonDiagnosisText" Text="{Binding SelectedComparisonRow.Diagnosis}" Foreground="#284D49" TextWrapping="Wrap" />
        </ScrollViewer>
      </Grid>
    </Border>

    <Border x:Name="DetailsPanel" Grid.Row="3" IsVisible="{Binding HasSelectedResult}"
            Background="White" CornerRadius="8" Padding="16">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Astronomische Tagesdetails" FontSize="18" FontWeight="SemiBold" />
          <Button Grid.Column="1" Content="Schließen" Command="{Binding CloseDetailsCommand}" Padding="10,3" />
        </Grid>
        <ContentControl Grid.Row="1" Content="{Binding SelectedResult}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ResultRow">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding DetailTitle}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LocationDetails}" Foreground="#556579" />
                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="4">
                  <TextBlock Text="Sonnenaufgang lokal" />
                  <TextBlock Grid.Column="1" Text="{Binding SunriseLocal}" />
                  <TextBlock Grid.Column="2" Text="Sonnenlänge" />
                  <TextBlock Grid.Column="3" Text="{Binding SunLongitude}" />
                  <TextBlock Grid.Row="1" Text="Sonnenaufgang UTC" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SunriseUtc}" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="Mondlänge" />
                  <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding MoonLongitude}" />
                  <TextBlock Grid.Row="2" Text="Tithi bei Sonnenaufgang" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TithiAtSunrise}" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="Winkeldifferenz" />
                  <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding AngularDifference}" />
                </Grid>
                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="#284D49" />
                <TextBlock Text="Geozentrische Längen am Sonnenaufgang · oberer Sonnenrand, Refraktion, Meereshöhe"
                           FontSize="12" Foreground="#556579" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Grid>
    </Border>
    <StackPanel Grid.Row="4" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ExportJsonButton" Content="JSON exportieren" Click="ExportJsonClicked" IsEnabled="{Binding CanExport}" />
        <Button x:Name="ExportCsvButton" Content="Vergleich als CSV" Click="ExportCsvClicked" IsEnabled="{Binding CanExportCsv}" />
        <Button x:Name="ExportVectorsButton" Content="Testvektoren exportieren" Click="ExportVectorsClicked" IsEnabled="{Binding CanExport}" />
      </StackPanel>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />
      <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" FontSize="12" Foreground="#556579" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
